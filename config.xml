<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://mathisland.game/monopoly"
        version="1.0.0"
        viewmodes="maximized">

    <tizen:application id="xGm0pMOnoP.Monopoly" package="xGm0pMOnoP" required_version="6.0"/>
    <tizen:profile name="tv-samsung"/>

    <name>Property Tycoon</name>
    <icon src="img/icon.png"/>
    <content src="index.html"/>

    <feature name="http://tizen.org/feature/screen.size.all"/>

    <!-- Game Mode for reduced input latency (2022+ TVs) -->
    <tizen:metadata key="http://samsung.com/tv/metadata/use.game.mode" value="true"/>

    <!-- Privileges -->
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <tizen:setting screen-orientation="landscape" context-menu="enable"
                   background-support="disable" encryption="disable"
                   install-location="auto" hwkey-event="enable"/>

    <access origin="*" subdomains="true"/>
</widget>
